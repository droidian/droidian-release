# This is the Droidian snapshot used as a base
Source: droidian-snapshot:@DROIDIAN_VERSION@-base
Suites: rolling
Components: main contrib non-free
Architectures: amd64 armhf arm64

# These are the update packages overlayed on top
Source: droidian-group:droidian:@DROIDIAN_VERSION@-updates
Suites: trixie
Components: main
Architectures: amd64 armhf arm64
Optional: yes

Source: droidian-group:droidian-devices:@DROIDIAN_VERSION@-updates
Suites: trixie
Components: main
Architectures: amd64 armhf arm64
Optional: yes

Source: droidian-group:droidian:@DROIDIAN_VERSION@-security
Suites: trixie
Components: main
Architectures: amd64 armhf arm64
Optional: yes

# 2025-09-27: cherry-pick newer rustc to build some phosh-adjacent projects
Source: debian-snapshot:20261022T143025Z
Suites: @DEBIAN_SUITE@
Components: main contrib non-free
Architectures: amd64 armhf arm64

# 2025-09-27: cherry-pick latest browsers
Cherry-Pick: src:firefox:158.0.1-1 src:libvpx:1.17.0-1 src:nss:2:3.131.1-1

Cherry-Pick: src:chromium:156.0.8078.47-1 libxml2-16:2.15.4+dfsg-1

Cherry-Pick: src:tzdata:2026e-1

Cherry-Pick: src:ca-certificates:20260816+nmu1

Cherry-Pick: src:glibc:2.43-7

Cherry-Pick: src:gcc-16:16.2.0-3

Mask: debian-snapshot:20261022T143025Z

# 2026-10-22: use a libhybris rebuilt against glibc 2.43, in
# a rather convoluted way, do not ask...
Source: droidian:droidian-libhybris:next-libhybris-101
Suites: trixie
Components: main
Architectures: amd64 armhf arm64

Package: *
Pin: release l=Droidian\ (droidian-libhybris-next-libhybris-101 channel)
Pin-Priority: 1050

# Always prefer update packages
Package: *
Pin: release l=Droidian\ (group-droidian-@DROIDIAN_VERSION@-updates channel)
Pin-Priority: 1050

Package: *
Pin: release l=Droidian\ (group-droidian-devices-@DROIDIAN_VERSION@-updates channel)
Pin-Priority: 1050

Package: *
Pin: release l=Droidian\ (group-droidian-@DROIDIAN_VERSION@-security channel)
Pin-Priority: 1049

# Ensure we keep high-priority packages
Keep: priority:1049
Keep: priority:1050

# Finally publish the snapshot
Target: ./droidian-snapshots/@DROIDIAN_VERSION@@DROIDIAN_PATCHLEVEL_SNAPSHOT@/
Suites: rolling
Architectures: amd64 armhf arm64
Components: main contrib non-free
Origin: Droidian
Label: Droidian (snapshot)
Version: @DROIDIAN_VERSION@
