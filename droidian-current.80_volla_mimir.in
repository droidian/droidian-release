# Droidian volla-mimir variant

# This is the Droidian snapshot used as a base
Source: droidian-snapshot:@DROIDIAN_VERSION@
Suites: rolling
Components: main contrib non-free
Architectures: arm64

# These are the mimir specific packages overlayed on top
Source: droidian-group:droidian:next-volla-mimir
Suites: trixie
Components: main
Architectures: arm64

Source: droidian-group:droidian-devices:next-volla-mimir
Suites: trixie
Components: main
Architectures: arm64

Package: *
Pin: release l=Droidian\ (group-droidian-next-volla-mimir channel)
Pin-Priority: 1050

Package: *
Pin: release l=Droidian\ (group-droidian-devices-next-volla-mimir\ channel)
Pin-Priority: 1050

# Ensure we keep high-priority packages
Keep: priority:1050

# Finally publish the snapshot
Target: ./droidian-snapshots/@DROIDIAN_VERSION@-volla-mimir/
Suites: rolling
Architectures: arm64
Components: main contrib non-free
Origin: Droidian
Label: Droidian (snapshot)
Version: @DROIDIAN_VERSION@
