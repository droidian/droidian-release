# Droidian waydroid13 variant

# This is the Droidian snapshot used as a base
Source: droidian-snapshot:@DROIDIAN_VERSION@@DROIDIAN_PATCHLEVEL_SNAPSHOT@
Suites: rolling
Components: main contrib non-free
Architectures: arm64

# These are the waydroid13 packages overlayed on top
Source: droidian:droidian-waydroid-images-api-29-bin:next-lineage20
Suites: trixie
Components: main
Architectures: arm64

Package: *
Pin: release l=Droidian\ (droidian-waydroid-images-api-29-bin-next-lineage20\ channel)
Pin-Priority: 1050

# Ensure we keep high-priority packages
Keep: priority:1050

# Finally publish the snapshot
Target: ./droidian-snapshots/@DROIDIAN_VERSION@@DROIDIAN_PATCHLEVEL_SNAPSHOT@-waydroid13/
Suites: rolling
Architectures: arm64
Components: main contrib non-free
Origin: Droidian
Label: Droidian (snapshot)
Version: @DROIDIAN_VERSION@
