# Droidian fxtec variant

# This is the Droidian snapshot used as a base
Source: droidian-snapshot:@DROIDIAN_VERSION@@DROIDIAN_PATCHLEVEL_SNAPSHOT@
Suites: rolling
Components: main contrib non-free
Architectures: arm64

# These are the F(x)tec specific packages overlayed on top
Source: droidian-group:droidian:102-keypad-slide-lights
Suites: trixie
Components: main
Architectures: arm64

Package: *
Pin: release l=Droidian\ (group-droidian-102-keypad-slide-lights channel)
Pin-Priority: 1050

# Ensure we keep high-priority packages
Keep: priority:1050

# Finally publish the snapshot
Target: ./droidian-snapshots/@DROIDIAN_VERSION@@DROIDIAN_PATCHLEVEL_SNAPSHOT@-fxtec/
Suites: rolling
Architectures: arm64
Components: main contrib non-free
Origin: Droidian
Label: Droidian (snapshot)
Version: @DROIDIAN_VERSION@
